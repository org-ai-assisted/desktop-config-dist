## AI-Assisted

## Start a Wayland-capable polkit authentication agent for the user session, if
## none is already running. Run from the Wayland session autostart.
##
## GUI tools that escalate via `pkexec --disable-internal-agent` (for example
## gparted) require an EXTERNAL polkit agent to be running in the session. The
## LXQt-on-labwc Wayland session autostarts none by default: mate-polkit ships
## an autostart gated to OnlyShowIn=MATE, and lxqt-policykit is not installed.
## Launch the first available agent here so the escalation prompt can appear.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## R-090 permits a fixed-path executable test in place of `has`.
polkit_agent_candidate_list=(
  /usr/lib/mate-polkit/polkit-mate-authentication-agent-1
  /usr/libexec/polkit-mate-authentication-agent-1
  /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
  /usr/libexec/polkit-gnome-authentication-agent-1
  /usr/bin/lxqt-policykit-agent
)

## Launched once per graphical-session start, and no other polkit agent
## autostarts in this session (mate-polkit's autostart is OnlyShowIn=MATE,
## lxqt-policykit is not installed), so start the first available agent
## unconditionally. A user-wide "already running" check is deliberately avoided:
## a polkit agent registers for one login session and cannot serve prompts in
## another, so a second simultaneous session (e.g. a nested or VNC session)
## needs its own agent rather than being suppressed by the first one's.
for polkit_agent in "${polkit_agent_candidate_list[@]}"; do
  if [ -x "${polkit_agent}" ]; then
    "${polkit_agent}" >/dev/null 2>&1 &
    exit 0
  fi
done

true "INFO: no polkit authentication agent found; pkexec GUI prompts (e.g. gparted) may not appear."
